# ==============================================================================
# FUNLOOF E-COMMERCE ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. OPTIONAL SUPABASE INTEGRATION
# If left blank, the app natively runs with built-in persistent JSON/in-memory database!
# To connect your cloud PostgreSQL Supabase database:
# Run the provided `supabase-schema.sql` in your Supabase SQL Editor and paste credentials:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 2. OPTIONAL STRIPE INTEGRATION (Mock checkout runs out-of-the-box)
# To process live real credit cards:
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# 3. SITE METADATA
NEXT_PUBLIC_SITE_URL=http://localhost:3000
